# Kopieren nach .env und anpassen. Beim Start per Task Scheduler musst du
# die Werte alternativ als System-Umgebungsvariablen setzen (Electron liest
# .env nicht automatisch - siehe README, Abschnitt "ENV laden").

POLL_INTERVAL_MS=30000
IDLE_THRESHOLD_MS=600000
CANCEL_WINDOW_MS=60000
SLEEP_ACTION=sleep

# Sekunden ohne Tastatur-/Mauseingabe, bis du als "weg" giltst. Erst danach
# laeuft IDLE_THRESHOLD_MS an - bis zur Aktion vergeht also die Summe aus
# beidem (Default: 5 min + 10 min = 15 min).
PRESENCE_IDLE_THRESHOLD_SEC=300

NETWORK_THRESHOLD_BYTES_PER_SEC=1500000
STEAM_PROCESS_NAMES=steam.exe,steamwebhelper.exe
STEAM_PATH=C:\Program Files (x86)\Steam

CLAUDE_SESSIONS_API_URL=https://dein-orchestrator.example.com/api/sessions/active
CLAUDE_SESSIONS_API_TOKEN=

# --- Fernsteuerung vom Handy ---
# Leer lassen = Fernsteuerung aus, App läuft rein lokal weiter.
CONTROL_PLANE_URL=https://dein-orchestrator.example.com
AGENT_NAME=Desktop
# Kommt aus: npx tsx scripts/register-machine.ts "Desktop"
AGENT_TOKEN=
HEARTBEAT_INTERVAL_MS=5000
